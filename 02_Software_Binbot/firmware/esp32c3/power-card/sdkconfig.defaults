CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_POWER_CARD_BUTTON_GPIO=3
CONFIG_POWER_CARD_BUTTON_PRESS_MS=500
CONFIG_POWER_CARD_BUTTON_ACTIVE_HIGH=y
CONFIG_POWER_CARD_RESET_GPIO=4
CONFIG_POWER_CARD_RESET_ACTIVE_HIGH=y
CONFIG_POWER_CARD_RESET_PRESS_MS=200
CONFIG_POWER_CARD_LOCAL_BUTTON_GPIO=5
CONFIG_POWER_CARD_LED_SENSE_GPIO=10
CONFIG_POWER_CARD_TCP_PORT=5000
