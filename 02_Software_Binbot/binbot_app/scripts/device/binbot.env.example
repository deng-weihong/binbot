# Copy to /oem/binbot.env and fill values for your device and server.
BINBOT_DEVICE_ID=binbot-001
BINBOT_DEVICE_TOKEN=
BINBOT_DIALOG_URL=ws://binbot.example.com:8080/v1/device/ws

BINBOT_CONTROL_ENABLE=0
BINBOT_MQTT_HOST=binbot.example.com
BINBOT_MQTT_PORT=1883
BINBOT_MQTT_CA_FILE=

BINBOT_WAKE_ENABLE=0
BINBOT_AGENT_ENABLE=0
